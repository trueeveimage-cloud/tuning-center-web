# Public DR-File configurator license. Obtain this for Tuning Center from DR-File.
VITE_DR_FILE_LICENSE=replace_with_tuning_center_license
# Optional server-only endpoint for provider-verified ECU and vehicle capabilities.
VEHICLE_CAPABILITY_API_URL=
# Optional server-only bearer token for the capability provider.
VEHICLE_CAPABILITY_API_KEY=
# Public DR-File configurator license. Obtain this for Tuning Center from DR-File.
VITE_DR_FILE_LICENSE=replace_with_tuning_center_license

# Optional: server-side vehicle-capability provider (ECU, AdBlue, DPF, EGR).
# When both are set, provider-verified data becomes the primary source in the
# registration lookup. Leave empty to use the conservative fallback layer.
VEHICLE_CAPABILITY_API_URL=
VEHICLE_CAPABILITY_API_KEY=
